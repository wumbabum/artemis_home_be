# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# In Synology Container Manager, you can either keep `.env` next to the
# compose file in the project directory or paste each value into the
# Environment tab when creating the project.

# --- Docker image ---
# Your Docker Hub (or other registry) username/namespace.
DOCKER_USERNAME=

# Image tag. Pin to a release version once published; `latest` works for dev.
ARTEMIS_VERSION=latest

# --- This BE instance ---
# Identifies this home BE. Must match an entry in the Auth0 user's
# `app_metadata.homes` list. Examples: alpha, beach_house, city_apt.
HOME_ID=

# Host port mapped to the container's internal port 6565.
HOST_PORT=6565

# Host path mounted into the container at /app/apps/core/priv/keys.
# Holds the BE's RSA session signing key. Keep this stable across deploys.
KEYS_PATH=./keys

# --- Phoenix ---
# Public hostname Phoenix uses for URL generation (e.g. alpha.artemis.example.com).
PHX_HOST=

# Long random string for Phoenix session/cookie signing.
# Generate one with: mix phx.gen.secret
SECRET_KEY_BASE=

# --- CORS ---
# Comma-separated list of origins allowed to call this BE from a browser
# (the FE running locally, on Fly, etc.). The browser enforces CORS based
# on the BE's response headers; any origin not listed here will see its
# preflight rejected. Example:
# CORS_ALLOWED_ORIGINS=http://localhost:6587,https://artemis-home.fly.dev
CORS_ALLOWED_ORIGINS=

# --- Auth0 ---
# Your Auth0 tenant domain (no trailing slash).
AUTH0_DOMAIN=

# Audience claim expected on access tokens. Shared across all home BEs.
AUTH0_AUDIENCE=https://artemis.app/api

# Machine-to-Machine app credentials scoped to read:users + update:users_app_metadata.
# Used by the seed task and any admin endpoints that update app_metadata.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Home Assistant ---
# Fully-qualified base URL for HA's REST API, INCLUDING the `/api` suffix
# (e.g. http://homeassistant.local:8123/api). v0.1 talks to HA via plain
# HTTP on the local network; TLS / mTLS deferred.
HA_BASE_URL=

# Long-lived HA access token. Generate in HA Profile -> Security ->
# Long-Lived Access Tokens. Stored at rest in env vars for v0.1.
HA_TOKEN=

# --- Postgres ---
# The `db` service uses these to initialize the cluster on first boot.
# Keep POSTGRES_PASSWORD strong even on a home LAN.
POSTGRES_USER=artemis
POSTGRES_PASSWORD=
POSTGRES_DB=artemis_home_be_prod

# DATABASE_URL the BE consumes. The username/password/db here must
# match POSTGRES_* above. The hostname `db` is the compose service name.
DATABASE_URL=postgres://artemis:CHANGE_ME@db:5432/artemis_home_be_prod

# Optional pool tuning. Default 10 is fine for a single home.
# DB_POOL_SIZE=10

# --- First-admin bootstrap ---
# Optional. When the `users` table is empty AND the incoming Auth0 `sub`
# matches this value, the first login becomes role `admin`. Subsequent
# logins (or with an unmatched sub) get role `guest`. Leave blank if
# you'll promote the admin manually after first login.
SEED_ADMIN_AUTH0_SUB=

# --- Misc ---
# Container timezone. Affects log timestamps. Use an IANA name.
TZ=UTC
