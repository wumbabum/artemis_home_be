# direnv template for local development.
#
# Usage:
#   1. cp .envrc.example .envrc
#   2. Fill in the empty values below (and edit HOME_ID / PORT if you're
#      running the "beta" instance).
#   3. direnv allow
#
# .envrc is gitignored; never commit it. `.env` (the Docker Compose
# template at .env.example) remains the canonical source for container
# deploys; this file is for local `mix phx.server` / `iex -S mix` /
# `mix seed.homes` workflows where direnv is more ergonomic.

# Load Docker Compose-style .env if present, without clobbering values
# explicitly exported below. Useful if you keep `.env` populated for
# `docker compose up` and want the same values active in your shell.
dotenv_if_exists .env

# --- Auth0 (shared across alpha and beta) ---
export AUTH0_DOMAIN="dev-ezdlwdjr4ru7505y.us.auth0.com"
export AUTH0_AUDIENCE="https://artemis-home.fly.dev"
export AUTH0_M2M_CLIENT_ID=""
export AUTH0_M2M_CLIENT_SECRET=""

# --- CORS (comma-separated allow-list of FE origins) ---
export CORS_ALLOWED_ORIGINS="http://localhost:6587,https://artemis-home.fly.dev"

# --- This BE instance ---
# Defaults below run alpha on :6565. For beta:
#   export HOME_ID=beta
#   export PORT=6566
# Or override per-invocation: HOME_ID=beta PORT=6566 mix phx.server
export HOME_ID="alpha"
export PORT="6565"

# --- Home Assistant ---
# Base URL including the /api suffix (e.g. http://homeassistant.local:8123/api).
# `runtime.exs` also accepts the legacy HOME_ASSISTANT_URL/HOME_ASSISTANT_API_KEY
# names for compatibility with older direnv configs.
export HA_BASE_URL=""
export HA_TOKEN=""

# --- Postgres ---
# Defaults assume a local Postgres reachable on the unix socket /tmp with
# the `postgres` superuser and no password. Override DATABASE_URL only if
# you need a non-default DSN; dev.exs handles the defaults.
# export DATABASE_URL="postgres://postgres:postgres@localhost/artemis_home_be_dev"

# --- First-admin bootstrap ---
# When the users table is empty AND your Auth0 sub matches this value,
# your first login is granted role `admin`. Leave blank if you'd rather
# promote yourself manually.
export SEED_ADMIN_AUTH0_SUB=""

# Pasted from Bruno when smoke-testing against the BE. Refresh it any
# time you re-run the OAuth flow.
export AUTH0_ACCESS_TOKEN=""
