# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix hex.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
artemis_home_be-*.tar

# BE-owned RSA signing keys never go in the repo.
apps/*/priv/keys/*.pem

# Local docker-compose env file with secrets. Use .env.example as the template.
/.env

# Local direnv config with secrets. Use .envrc.example as the template.
/.envrc
# Editor/sed/cp backup files (`.envrc.bak`, `*.swp`, etc.). Never commit.
.envrc.*
!.envrc.example
*.bak

# Host bind-mount target used by docker-compose for the session signing keys.
/keys/

# v0 planning material kept local.
/temp/
